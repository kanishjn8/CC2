# ── Database ──────────────────────────────────────────────────────────────────
# Local dev  (postgres running directly on your machine / via docker compose up postgres)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.bzwzzcajkwgzxepiotng.supabase.co:5432/postgrespostgresql://postgres:3VpnHY1F6mTq8sZs@db.bzwzzcajkwgzxepiotng.supabase.co:5432/postgres

# Docker Compose full-stack  (used automatically by the api service via docker-compose.yaml)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cc2_db

# ── Simulation ────────────────────────────────────────────────────────────────
SIM_TICK_INTERVAL=2.0
SIM_SPEED=10.0

# ── Seed counts ───────────────────────────────────────────────────────────────
SEED_WAREHOUSES=5
SEED_CARRIERS=8
SEED_ROUTES=12
SEED_SHIPMENTS=20

# ── Agent ─────────────────────────────────────────────────────────────────────
AGENT_TICK_INTERVAL=60.0
RISK_THRESHOLD=0.6
BOTTLENECK_THRESHOLD=0.85
CARRIER_RELIABILITY_THRESHOLD=0.5

# Minimum seconds between any two LLM API calls (prevents free-tier rate-limit exhaustion)
# 300 = 5 minutes — safe for free tier; lower if on a paid plan
LLM_CALL_COOLDOWN=300.0

# ── SMTP Email (alert actions) ────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=alerts@routesense.ai
ALERT_EMAIL_TO=operator@example.com
# Minimum seconds between any two alert emails (global cooldown)
# 300 = 5 min, 600 = 10 min, 3600 = 1 hour
ALERT_EMAIL_COOLDOWN=300

# ── Gemini LLM ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=models/gemini-2.0-flash
GEMINI_FALLBACK_MODEL=models/gemini-2.0-flash-lite

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Set to your actual Vercel/production URL before deploying.
# Leave as * for local development only.
ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=https://your-app.vercel.app